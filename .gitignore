areas/phdwin-v2/mcp-servers/PHDWinv2_MCP/reference/templates/*.mdb
areas/phdwin-v2/mcp-servers/PHDWinv2_MCP/reference/templates/*.sqlite
areas/phdwin-v2/mcp-servers/PHDWinv2_MCP/reference/templates/*.sqlite3
areas/phdwin-v2/mcp-servers/PHDWinv2_MCP/reference/templates/*.db
