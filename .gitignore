# Secrets and local configuration
.env
.env.*
!**/.claude-plugin/
!**/.claude-plugin/**
!**/.mcp.json
!.claude-plugin/marketplace.json
*.pem
*.key
*.pfx
*.p12
*.kdbx
secrets/
private/

# Local planning
docs/planning.md

# Local end-to-end test workspaces
e2e-local/**
!e2e-local/
!e2e-local/README.md
!e2e-local/*/
!e2e-local/*/README.md
!e2e-local/run_*.py
!e2e-local/*/run_*.py
# Committed E2E fixtures (forecasting CSVs anonymized; .phz/.accdb are demo data)
# NB: .accdb is re-included further down, after the global *.accdb ignore
!e2e-local/forecasting/*.csv
!e2e-local/phdwin-v2/Phdwinv2-db/
!e2e-local/phdwin-v2/Phdwinv2-db/*.phz

# Local helper scripts
scripts/*
!scripts/build_reference_sqlite_templates.py
!scripts/validate_aries_accdb.py
phdwin_cli_test.log

# Raw database exports and local data
*.bak
*.bacpac
*.dacpac
*.mdb
*.accdb
*.sqlite
*.sqlite3
*.db
# Re-include committed E2E Aries .accdb fixtures (override global *.accdb above)
!e2e-local/aries/*.accdb
exports/
data/
dist/
tmp/
!areas/*/mcp-servers/*/data/
